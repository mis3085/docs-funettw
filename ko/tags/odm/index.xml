    &lt;div id=&#34;전자-제조-및-조립-솔루션-전문성&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ec%a0%84%ec%9e%90-%ec%a0%9c%ec%a1%b0-%eb%b0%8f-%ec%a1%b0%eb%a6%bd-%ec%86%94%eb%a3%a8%ec%85%98-%ec%a0%84%eb%ac%b8%ec%84%b1&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
