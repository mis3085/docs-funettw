        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e0%a4%b5%e0%a4%b5%e0%a4%a7-%e0%a4%85%e0%a4%a8%e0%a4%aa%e0%a4%b0%e0%a4%af%e0%a4%97-%e0%a4%95-%e0%a4%b2%e0%a4%8f-%e0%a4%85%e0%a4%a8%e0%a4%95%e0%a4%b2%e0%a4%a4-%e0%a4%ae%e0%a4%9f%e0%a4%b0-%e0%a4%a1%e0%a4%b0%e0%a4%87%e0%a4%b5%e0%a4%b0-%e0%a4%94%e0%a4%b0-%e0%a4%aa%e0%a4%b5%e0%a4%b0-%e0%a4%95%e0%a4%9f%e0%a4%b0%e0%a4%b2-%e0%a4%af%e0%a4%a8%e0%a4%9f&#34; aria-label=&#34;Anchor&#34;&gt;#&lt;/a&gt;
